      "event": {
        "name": "NETWORK_CHANGED",
        "version": "1.0.0",
        "id": "2a000001-0000-4000-8000-000000000015",
        "timestamp": "2026-02-11T10:13:00.000Z",
        "source": "tab-8f2a",
        "payload": { "network": "mainnet" }
      }
    },
    {
      "name": "THEME_MUTATED missing mode",
      "expect": "rejected",
      "reason": "invalid-payload",
      "event": {
        "name": "THEME_MUTATED",
        "version": "1.0.0",
