        "source": "tab-8f2a",
        "payload": {}
      }
    },
    {
      "name": "sw-update with available false, which the literal forbids",
      "expect": "rejected",
      "reason": "invalid-payload",
      "event": {
        "name": "sw-update",
        "version": "1.0.0",
        "id": "2a000001-0000-4000-8000-00000000000b",
        "timestamp": "2026-02-11T10:08:00.000Z",
        "source": "pwa-utils",
        "payload": { "available": false }
      }
    },
    {
      "name": "WALLET_DISCONNECTED with a non-string reason",
      "expect": "rejected",
      "reason": "invalid-payload",
      "event": {
        "name": "WALLET_DISCONNECTED",
        "version": "1.0.0",
        "id": "2a000001-0000-4000-8000-00000000000c",
        "timestamp": "2026-02-11T10:09:00.000Z",
