{
  "name": "trellis-frontend",
  "version": "0.1.1",
  "description": "AI agent marketplace on Stellar, built on the Trellis design system",
  "private": true,
  "scripts": {
    "dev": "node api.js && tsx scripts/validate-env.ts && next dev",
    "build": "node api.js && tsx scripts/validate-env.ts && tsx scripts/generate-openapi.ts && next build",
    "start": "node api.js && tsx scripts/validate-env.ts && next start",
    "validate:env": "tsx scripts/validate-env.ts",
    "diagnostics": "node scripts/diagnostics.mjs",
    "doctor": "node scripts/diagnostics.mjs",
    "validate:diagnostics": "node --test scripts/verify-diagnostics.mjs",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "playwright test e2e/a11y.spec.ts",
    "test:e2e:chaos": "playwright test e2e/chaos.spec.ts",
    "validate:a11y": "node scripts/verify-a11y-regressions.mjs",
    "validate:invariants": "node scripts/validate-domain-invariants.mjs",
    "dr:validate": "node scripts/validate-domain-invariants.mjs",
    "monitor:invariants": "tsx scripts/validate-domain-events.ts && tsx scripts/monitor-invariants.ts",
    "validate:events": "tsx scripts/validate-domain-events.ts",
    "drill:verify": "node scripts/incident-drill.mjs",
    "telemetry:ws": "node scripts/telemetry-ws-server.mjs",
    "analyze": "source-map-explorer .next/static/**/*.js",
    "analyze:budget": "node scripts/check-bundle-budget.mjs",
    "test:resource-budgets": "node scripts/check-resource-budgets.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "monitor:journey": "tsx scripts/synthetic-journey-monitor.ts",
    "backfill": "tsx scripts/backfill/index.ts",
    "backfill:dry-run": "tsx scripts/backfill/index.ts --dry-run",
    "validate:backfill": "node --test scripts/backfill/verify-backfill.mjs"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^6.4.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@ledger/tw-app-str": "^7.7.7",
    "@ledger/tw-transport-webhid": "^6.36.0",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "@stellar/freighter-api": "^6.0.0",
    "@stellar/stellar-sdk": "^14.0.0",
    "@tanstack/react-query": "^4.0.0",
    "@types/react-window": "~1.8.8",
    "algoliasearch": "^4.26.0",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "critters": "^0.0.23",
    "diff": "^8.0.4",
    "dompurify": "^3.2.6",
    "ii8next": "^26.0.8",
    "ii8next-browser-languagedetector": "^8.2.1",
    "ipfs-http-client": "^60.0.1",
    "next": "^16.1.6",
    "next-pwa": "^5.6.0",
    "nft.storage": "^7.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "~17.0.4",
    "react-window": "~2.2.7",
    "recharts": "^2.12.7",
    "snarkjz": "^0.7.5",
    "sonner": "^2.0.7",
    "stylis-plugin-rtl": "^2.1.1",
    "swagger-ui-react": "^5.11.0",
    "use-debounce": "^10.1.0",
    "workbox-webpack-plugin": "^7.0.0",
    "ws": "^8.18.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.12"
  },
  "optionalDependencies": {
    "@xenova/transformers": "^2.17.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-styling-webpack": "^3.0.2",
    "@storybook/nextjs": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^7.0.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/semver": "^7.7.1",
    "@types/swagger-ui-react": "^4.18.3",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.0",
    "source-map-explorer": "^2.5.3",
    "storybook": "^10.6.0",
    "tailwindcss": "^3.3.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.0"
  },
  "type": "module"
}
