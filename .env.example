# Environment Variables Template

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ENVIRONMENT=development
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Optional server-only webhook signing secret. Generate a unique random value (32+ characters).
# WEBHOOK_SECRET=

# Server-only HMAC secret used to sign actor tokens for the permission matrix
# (docs/PERMISSIONS.md). Must be at least 32 characters. Privileged routes fail
# closed with a 500 when it is unset — they never fall back to a default role.
# Generate with: openssl rand -base64 48
# PERMISSION_TOKEN_SECRET=

# Analytics (optional)
# NEXT_PUBLIC_ANALYTICS_ID=

# Feature Flags (optional)
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# Agent telemetry (optional — omit NEXT_PUBLIC_TELEMETRY_WS_URL to use the built-in mock stream)
# WebSocket url: also used as the WebRTC signalling channel and as the fallback transport
# NEXT_PUBLIC_TELEMETRY_WS_URL=ws://127.0.0.1:3456
# OPERATIONAL_HEALTH_RPC_URL=https://your-soroban-rpc.example
# TELEMETRY_WS_PORT=3456
# Set to 0 to skip WebRTC and always stream over WebSocket (default: prefer WebRTC)
# NEXT_PUBLIC_TELEMETRY_WEBRTC=1
# Comma-separated STUN urls (default: stun:stun.l.google.com:19302)
# NEXT_PUBLIC_TELEMETRY_STUN_URLS=
# TURN fallback for peers behind symmetric NAT / restrictive firewalls
# NEXT_PUBLIC_TELEMETRY_TURN_URL=
# NEXT_PUBLIC_TELEMETRY_TURN_USERNAME=
# NEXT_PUBLIC_TELEMETRY_TURN_CREDENTIAL=
# Full ICE override as a JSON array (takes precedence over the variables above)
# NEXT_PUBLIC_TELEMETRY_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Metrics dashboard (optional — omit to use built-in mock metrics)
# Prometheus HTTP API base URL (server-side only; do NOT prefix with NEXT_PUBLIC)
# Example: http://localhost:9090
# METRICS_PROMETHEUS_BASE_URL=
#
# If using OpenTelemetry Collector, you can point this at its Prometheus exporter
# Example: http://localhost:9464
# METRICS_OTEL_PROMETHEUS_BASE_URL=

# API rate limiting (optional — defaults to enabled with the built-in budgets)
# Set to false to disable enforcement while still returning X-RateLimit-* headers.
# RATE_LIMIT_ENABLED=true
#
# Number of trusted proxies in front of the app. 0 means "use the address our own
# edge appended to x-forwarded-for" (the rightmost entry, which a client cannot spoof).
# RATE_LIMIT_TRUST_PROXY_HOPS=0
#
# Localhost is exempt outside production by default; force false to enforce it in dev.
# RATE_LIMIT_BYPASS_LOCALHOST=false
#
# Per-scope budgets (scope: default burst / per-minute refill / token cost)
#   public    60/min  cost 1     search  30/min  cost 1
#   mutation  20/min  cost 2     heavy   10/min  cost 1
#   auth       5/min  cost 1
# RATE_LIMIT_PUBLIC_BURST=60
# RATE_LIMIT_PUBLIC_REFILL_PER_SECOND=1
# RATE_LIMIT_SEARCH_BURST=30
# RATE_LIMIT_SEARCH_REFILL_PER_SECOND=0.5
# RATE_LIMIT_HEAVY_BURST=10
# RATE_LIMIT_HEAVY_REFILL_PER_SECOND=0.16666666666666666
# RATE_LIMIT_AUTH_BURST=5
# RATE_LIMIT_AUTH_REFILL_PER_SECOND=0.08333333333333333
# RATE_LIMIT_MUTATION_BURST=20
# RATE_LIMIT_MUTATION_REFILL_PER_SECOND=0.3333333333333333
# RATE_LIMIT_MUTATION_COST=2
